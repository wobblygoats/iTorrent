# Copy to .env (git-ignored) for `make release` / `make testflight` by hand; the runner passes
# the same values as secrets.

# App Store Connect API key: App Store Connect → Users and Access → Integrations → App Store
# Connect API → Team Keys → Generate, role Admin, or App Manager with "Access to Cloud Managed
# Distribution Certificate" ticked. Signing with a key, Xcode uses only cloud-managed distribution
# certificates (an Apple Distribution certificate in the keychain is ignored), so without that
# access the export fails with "Cloud signing permission error". A key's role can't be changed
# afterwards; generate a new one. The Mac release signs with the Developer ID certificate in the
# keychain (cloud signing does not issue one through a key) and notarizes with this key.
ASC_KEY_ID=
ASC_ISSUER_ID=
# The .p8 downloads once only. Keep it outside the repository; the default is
# ~/.private_keys/AuthKey_<ASC_KEY_ID>.p8 (also where Apple's altool looks).
#ASC_KEY_PATH=~/.private_keys/AuthKey_XXXXXXXXXX.p8
